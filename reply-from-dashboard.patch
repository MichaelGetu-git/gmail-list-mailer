+
+// ------------------------------------------------------------------ one conversation
+//
+// Everything between this account and one contact in All Mail, both ways
+// (their replies and what we sent them), oldest first, as plain text. Read
+// live for the dashboard's conversation view; nothing is stored.
+
+const MAX_TEXT = 20000;
+
+const entity = (s) => s.replace(/&nbsp;/gi, ' ').replace(/&amp;/gi, '&').replace(/&lt;/gi, '<').replace(/&gt;/gi, '>')
+  .replace(/&quot;/gi, '"').replace(/&#0*39;|&apos;/gi, "'").replace(/&#(\d+);/g, (_, n) => String.fromCodePoint(Number(n)));
+// Good enough for reading an email: block ends become line breaks, tags go.
+export function htmlToText(html) {
+  return entity(String(html || '')
+    .replace(/<(style|script|head)[^>]*>[\s\S]*?<\/\1>/gi, '')
+    .replace(/<br\s*\/?>/gi, '\n')
+    .replace(/<\/(p|div|tr|li|h\d|blockquote)>/gi, '\n')
+    .replace(/<[^>]+>/g, ''))
+    .replace(/[ \t]+\n/g, '\n').replace(/\n{3,}/g, '\n\n').trim();
+}
+
+// The part to show: text/plain if there is one, else text/html; never an attachment.
+function textPart(node) {
+  let html = null;
+  const walk = (n) => {
+    if (!n) return null;
+    if (n.childNodes?.length) {
+      for (const c of n.childNodes) { const p = walk(c); if (p) return p; }
+      return null;
+    }
+    if (n.disposition === 'attachment') return null;
+    if (n.type === 'text/plain') return { part: n.part || '1', html: false };
+    if (n.type === 'text/html' && !html) html = { part: n.part || '1', html: true };
+    return null;
+  };
+  return walk(node) || html;
+}
+
+async function streamText(stream, max) {
+  let out = '';
+  for await (const chunk of stream) {
+    out += chunk.toString('utf8');
+    if (out.length > max * 4) break;
+  }
+  return out;
+}
+
+// addrs: the contact's addresses (the one we emailed, and the one they
+// answered from if different). since: ms.
+export async function readThread(account, addrs, { since, limit = 30 } = {}) {
+  const client = factory(account);
+  const self = String(account).toLowerCase();
+  const list = [...new Set(addrs.map((a) => String(a || '').toLowerCase()).filter(Boolean))];
+  await client.connect();
+  try {
+    const lock = await client.getMailboxLock(await mailboxOf(client), { readOnly: true });
+    try {
+      const who = list.flatMap((a) => [{ from: a }, { to: a }]);
+      const uids = (await client.search({ since: new Date(since), or: who }, { uid: true })) || [];
+      const recent = uids.slice(-limit);
+      const msgs = [];
+      if (recent.length) {
+        // Collected first: imapflow cannot run another command inside a fetch loop.
+        for await (const m of client.fetch(recent, { uid: true, envelope: true, internalDate: true, bodyStructure: true, headers: ['references'] }, { uid: true })) {
+          const from = m.envelope?.from?.[0] || {};
+          const h = headerMap(m.headers);
+          msgs.push({
+            uid: m.uid,
+            at: new Date(m.internalDate || m.envelope?.date || 0).getTime(),
+            from: String(from.address || '').toLowerCase(), fromName: from.name || '',
+            to: (m.envelope?.to || []).map((t) => String(t.address || '').toLowerCase()).filter(Boolean),
+            subject: String(m.envelope?.subject || ''),
+            messageId: m.envelope?.messageId || '',
+            references: msgIds(h.references).map((id) => `<${id}>`),
+            part: textPart(m.bodyStructure),
+          });
+        }
+      }
+      for (const m of msgs) {
+        let text = '';
+        if (m.part && typeof client.download === 'function') {
+          try {
+            const { content } = await client.download(m.uid, m.part.part, { uid: true, maxBytes: 2000000 });
+            const raw = await streamText(content, MAX_TEXT);
+            text = m.part.html ? htmlToText(raw) : raw.replace(/\r\n/g, '\n').trim();
+          } catch { text = ''; }
+        }
+        m.text = text.slice(0, MAX_TEXT);
+        m.ours = m.from === self;
+        delete m.part;
+      }
+      return msgs.sort((a, b) => a.at - b.at);
+    } finally { lock.release(); }
+  } finally {
+    await client.logout().catch(() => {});
+  }
+}
diff --git a/server/api/_inbox.js b/server/api/_inbox.js
new file mode 100644
index 0000000000000000000000000000000000000000..57c6a6cbfe9baf3bfac932a8521d8d58caa16631
--- /dev/null
+++ b/server/api/_inbox.js
@@ -0,0 +1,120 @@
+// Answering replies from the dashboard.
+//
+// conversation(email) reads the whole exchange with one contact live from the
+// account that emailed them (All Mail over IMAP: their replies and what we
+// sent), so the Replies tab can show it. answer({email, text}) sends a reply
+// from that same account over SMTP, threaded onto their latest message
+// (In-Reply-To / References, "Re:" subject), so it lands in the same Gmail
+// conversation on both sides; Gmail files it in the account's Sent mail.
+//
+// Writing to someone yourself stops their automatic follow-ups.
+import { command } from './_store.js';
+import { K, readSettings, hasPassword, passwordVar } from './_settings.js';
+import { readConfig } from './config.js';
+import { addLog, fromHeader, senderOf, withLock } from './_engine.js';
+import { normEmail } from './_render.js';
+import { transportFor } from './_smtp.js';
+import { readThread } from './_imap.js';
+
+const DAY = 86400000;
+const MAX_ANSWER = 20000;
+const parse = (s, d = null) => { try { return s ? JSON.parse(s) : d; } catch { return d; } };
+const bad = (msg, status = 400) => Object.assign(new Error(msg), { status });
+const asId = (id) => { const s = String(id || '').trim(); return !s ? '' : s.startsWith('<') ? s : `<${s}>`; };
+
+async function recordOf(email) {
+  const e = normEmail(email);
+  const rec = parse(await command('HGET', K.sent, e));
+  if (!rec) throw bad('the dashboard never emailed this address', 404);
+  if (!rec.account) throw bad('no sending account recorded for this contact');
+  return { e, rec };
+}
+
+const addrsOf = (e, rec) => [e, rec.replyFrom].filter(Boolean);
+// From a day before our first email, so the whole exchange is there.
+const sinceOf = (rec, now) => Math.min(now, Number(rec.firstSentAt) || now - 60 * DAY) - DAY;
+
+export async function conversation(email, now = Date.now()) {
+  const { e, rec } = await recordOf(email);
+  const account = rec.account;
+  const settings = await readSettings();
+  const config = await readConfig();
+  const { senderName } = senderOf(config, account);
+  const row = rec.row || {};
+  const base = {
+    email: e, account, senderName, name: row.name || [row.first_name, row.last_name].filter(Boolean).join(' '),
+    firstName: row.first_name || '', company: rec.company || row.company || '',
+    replyTo: rec.replyFrom || e, answers: rec.answers || [], dryRun: Boolean(settings.dryRun),
+  };
+  if (!hasPassword(account)) return { ...base, messages: [], error: `no app password set for ${account} (${passwordVar(account)})` };
+  try {
+    const messages = await readThread(account, addrsOf(e, rec), { since: sinceOf(rec, now) });
+    return { ...base, messages };
+  } catch (err) {
+    return { ...base, messages: [], error: `could not read ${account}'s mailbox: ${String(err?.responseText || err?.message || err).slice(0, 200)}` };
+  }
+}
+
+const reSubject = (s) => { const t = String(s || '').trim(); return /^re:/i.test(t) ? t : `Re: ${t}`; };
+const stamp = (ms) => new Date(ms).toLocaleString('en-GB', { timeZone: 'Africa/Nairobi', weekday: 'short', day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
+// Their message under ours, quoted the way mail apps do.
+export function quoted(m) {
+  if (!m?.text) return '';
+  const who = m.fromName ? `${m.fromName} <${m.from}>` : m.from;
+  const body = m.text.slice(0, 8000).split('\n').map((l) => (l.startsWith('>') ? `>${l}` : `> ${l}`)).join('\n');
+  return `\n\nOn ${stamp(m.at)}, ${who} wrote:\n${body}`;
+}
+
+export async function answer({ email, text, now = Date.now() } = {}) {
+  const body = String(text ?? '').replace(/\r\n/g, '\n');
+  if (!body.trim()) throw bad('write something to send');
+  if (body.length > MAX_ANSWER) throw bad(`keep it under ${MAX_ANSWER.toLocaleString('en-GB')} characters`);
+  const { e, rec } = await recordOf(email);
+  const account = rec.account;
+  const settings = await readSettings();
+  const dryRun = Boolean(settings.dryRun);
+  if (!dryRun && !hasPassword(account)) throw bad(`no app password set for ${account} (${passwordVar(account)})`);
+  const config = await readConfig();
+  const { senderName } = senderOf(config, account);
+
+  // Thread onto their latest message. If the mailbox can't be read, fall back
+  // to our last email to them and the subject of their reply.
+  let last = null;
+  try {
+    const msgs = await readThread(account, addrsOf(e, rec), { since: sinceOf(rec, now) });
+    last = [...msgs].reverse().find((m) => !m.ours) || null;
+  } catch { last = null; }
+  const touches = rec.touches || [];
+  const ours = asId(touches[touches.length - 1]?.messageId);
+  const parent = asId(last?.messageId) || ours;
+  const references = last ? [...(last.references || []), asId(last.messageId)].filter(Boolean) : [ours].filter(Boolean);
+  const to = last?.from || rec.replyFrom || e;
+  const subject = reSubject(last?.subject || rec.replySubject || rec.subject || '');
+  const mail = {
+    from: fromHeader(senderName, account), to, subject, text: body.trimEnd() + quoted(last),
+    ...(parent ? { inReplyTo: parent } : {}), ...(references.length ? { references: [...new Set(references)].slice(-20) } : {}),
+  };
+
+  const transport = transportFor(account, { dryRun });
+  let info;
+  try {
+    info = await transport.sendMail(mail);
+  } catch (err) {
+    const msg = String(err?.response || err?.message || err).slice(0, 300);
+    await addLog({ account, to, subject, status: 'answer failed', templateId: rec.template, error: msg });
+    throw bad(`send failed: ${msg}`, 502);
+  } finally { try { transport.close?.(); } catch { /* ignore */ } }
+
+  const messageId = info?.messageId || '';
+  await addLog({ account, to, subject, status: dryRun ? 'answered (dry-run)' : 'answered', templateId: rec.template, messageId,
+    response: String(info?.response || '').slice(0, 200) }, { subject, text: mail.text, from: account, plain: true });
+  // Under the lock: the inbox scan rewrites this record too.
+  await withLock(async () => {
+    const cur = parse(await command('HGET', K.sent, e)) || rec;
+    cur.answers = [...(cur.answers || []), { at: now, messageId, subject, ...(dryRun ? { dryRun: true } : {}) }].slice(-50);
+    cur.answeredAt = now;
+    await command('HSET', K.sent, e, JSON.stringify(cur));
+    await command('ZREM', K.fu, e);
+  }, { waitMs: 15000 });
+  return { ok: true, dryRun, to, subject, messageId, account };
+}
